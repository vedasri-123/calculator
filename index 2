<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ShopKart - Online Shopping</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #f5f5f5;
        }

        /* HEADER */

        header {
            background-color: #2874f0;
            color: white;
            height: 70px;

            display: flex;
            align-items: center;
            justify-content: space-around;

            padding: 10px 30px;
        }

        .logo {
            font-size: 28px;
            font-weight: bold;
        }

        .search-box {
            display: flex;
            width: 45%;
        }

        .search-box input {
            width: 100%;
            padding: 13px;
            border: none;
            outline: none;
            font-size: 15px;
        }

        .search-box button {
            padding: 13px 20px;
            border: none;
            background-color: #ff9f00;
            color: white;
            cursor: pointer;
        }

        .login {
            background-color: white;
            color: #2874f0;
            padding: 10px 20px;
            font-weight: bold;
            cursor: pointer;
        }

        .cart {
            font-size: 18px;
            cursor: pointer;
        }


        /* NAVIGATION */

        nav {
            background-color: white;
            padding: 16px;
            text-align: center;
            box-shadow: 0 2px 5px #ccc;
        }

        nav a {
            color: #333;
            text-decoration: none;
            margin: 0 25px;
            font-weight: bold;
        }

        nav a:hover {
            color: #2874f0;
        }


        /* HERO BANNER */

        .hero {
            height: 350px;

            background: linear-gradient(
                90deg,
                #2874f0,
                #6a11cb
            );

            color: white;

            display: flex;
            align-items: center;
            justify-content: center;

            text-align: center;
        }

        .hero h1 {
            font-size: 50px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 22px;
            margin-bottom: 25px;
        }

        .shop-button {
            background-color: #ff9f00;
            color: white;
            border: none;

            padding: 14px 35px;

            font-size: 18px;
            font-weight: bold;

            cursor: pointer;
        }

        .shop-button:hover {
            background-color: #fb8c00;
        }


        /* CATEGORIES */

        .section {
            padding: 40px 5%;
        }

        .section-title {
            text-align: center;
            font-size: 30px;
            margin-bottom: 30px;
        }

        .categories {
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
        }

        .category {
            background-color: white;

            width: 180px;
            padding: 25px;

            text-align: center;

            border-radius: 8px;

            box-shadow: 0 2px 8px #ccc;

            cursor: pointer;
        }

        .category:hover {
            transform: translateY(-5px);
            transition: 0.3s;
        }

        .category-icon {
            font-size: 55px;
            margin-bottom: 10px;
        }


        /* PRODUCTS */

        .products {
            display: flex;
            justify-content: center;

            gap: 25px;

            flex-wrap: wrap;
        }

        .product {
            background-color: white;

            width: 250px;

            padding: 20px;

            border-radius: 8px;

            box-shadow: 0 2px 8px #ccc;

            text-align: center;
        }

        .product:hover {
            transform: translateY(-5px);
            transition: 0.3s;
        }

        .product-image {
            height: 170px;

            background-color: #eeeeee;

            display: flex;
            justify-content: center;
            align-items: center;

            font-size: 80px;

            margin-bottom: 15px;
        }

        .product h3 {
            font-size: 20px;
            margin-bottom: 10px;
        }

        .product p {
            color: #666;
            margin-bottom: 10px;
        }

        .price {
            color: #e53935 !important;
            font-size: 22px;
            font-weight: bold;
        }

        .add-cart {
            width: 100%;

            padding: 12px;

            background-color: #2874f0;

            color: white;

            border: none;

            font-size: 16px;

            cursor: pointer;

            border-radius: 4px;
        }

        .add-cart:hover {
            background-color: #1255c5;
        }


        /* OFFER */

        .offer {
            background-color: #ff9f00;

            color: white;

            text-align: center;

            padding: 45px;
        }

        .offer h2 {
            font-size: 35px;
            margin-bottom: 10px;
        }

        .offer p {
            font-size: 20px;
            margin-bottom: 20px;
        }

        .offer button {
            padding: 12px 30px;

            border: none;

            background-color: white;

            color: #ff8c00;

            font-weight: bold;

            cursor: pointer;
        }


        /* FOOTER */

        footer {
            background-color: #172337;

            color: white;

            padding: 40px;

            display: flex;

            justify-content: space-around;

            flex-wrap: wrap;

            gap: 30px;
        }

        footer h3 {
            margin-bottom: 15px;
        }

        footer p {
            margin: 8px 0;
            color: #ddd;
        }

        .copyright {
            background-color: #0d1726;

            color: white;

            text-align: center;

            padding: 15px;
        }


        /* MOBILE */

        @media (max-width: 768px) {

            header {
                height: auto;
                flex-direction: column;
                gap: 15px;
            }

            .search-box {
                width: 90%;
            }

            nav a {
                display: inline-block;
                margin: 8px;
            }

            .hero h1 {
                font-size: 35px;
            }

            .hero p {
                font-size: 17px;
            }

            footer {
                text-align: center;
                flex-direction: column;
            }

        }

    </style>

</head>


<body>


