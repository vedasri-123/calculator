    <!-- JAVASCRIPT -->

    <script>

        let cartCount = 0;


        function addToCart(product) {

            cartCount++;

            document.getElementById(
                "cart-count"
            ).innerText = cartCount;

            alert(
                product + " added to cart!"
            );

        }


        function searchProduct() {

            let product =
                document.getElementById(
                    "search"
                ).value;

            if (product.trim() === "") {

                alert(
                    "Please enter a product name."
                );

            } else {

                alert(
                    "Searching for: " + product
                );

            }

        }


        function login() {

            alert(
                "Login page will open here."
            );

        }


        function goToProducts() {

            document
                .getElementById("products")
                .scrollIntoView({
                    behavior: "smooth"
                });

        }


        function showOffer() {

            alert(
                "Coupon SHOP50 applied! You get 10% OFF."
